# Copia este archivo como ".env" y completa tus propios valores.
# Nunca subas el archivo ".env" real a GitHub (ya está en .gitignore).

# URL de conexión a MongoDB Atlas (la obtienes al crear tu cluster gratuito)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/taskflow

# Clave secreta para firmar los tokens JWT (invéntate cualquier texto largo)
JWT_SECRET=cambia_esto_por_un_texto_secreto_largo_y_unico

# Puerto donde correrá el servidor
PORT=3000
